---
interface Props {
    venueName: string;
    address: string[];
    mapEmbedUrl: string;
    googleMapsLink: string;
}

const { venueName, address, mapEmbedUrl, googleMapsLink } = Astro.props;
---

<section
    class="card relative mx-auto mt-12 max-w-240 p-[clamp(1.5rem,4vw,2.5rem)]"
    aria-labelledby="location-heading"
>
    <h2 id="location-heading" class="mb-5 font-display text-gold">
        Ubicación
    </h2>
    <div class="grid gap-6 md:grid-cols-1">
        {mapEmbedUrl && (
            <iframe
                src={mapEmbedUrl}
                width="100%"
                height="400px"
                style="border:none;"
            />
        )}
        <div>
            <h3 class="mb-2 font-display text-crimson">{venueName}</h3>
            {address.map((line) => (
                <p class="my-[0.15rem] text-black">{line}</p>
            ))}
        </div>
        <a
            href={googleMapsLink}
            class="mt-6 inline-block rounded-sm border-0 bg-velvet px-8 py-3 font-display tracking-[0.06em] text-cream transition-colors duration-200 hover:bg-crimson text-center"
        >
            Abir google maps
        </a>
    </div>
</section>
