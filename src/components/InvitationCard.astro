---
import EnvelopeGif from "../assets/cardNoLoop.gif";
import EnvelopeOpen from "../assets/FlatEnvlopedOpen.svg";
import waxSeal from "../assets/waxSeal.svg";
import judith from "../assets/JudithPhoto.png";

interface Props {
    displayDate: string;
}

const { displayDate } = Astro.props;
---

<img src={EnvelopeOpen.src} alt="invitation gif" id="invitation-card" />

<article class="relative mx-auto max-w-170 border-2 border-gold bg-parchment p-[clamp(1.5rem,5vw,3.25rem)] text-center text-canvas before:pointer-events-none before:absolute before:inset-2.5 before:content-[''] before:border before:border-gold">
    <div class="relative grid justify-items-center gap-5">
        <p class="text-[1.35rem] italic">
            Estimado/a <span data-guest-name>invitado/a</span>,
        </p>
        <p class="max-w-[34ch] text-[1.15rem] leading-[1.6]">
            Te invito cordialmente a celebrar mi graduación
        </p>
        <img src={judith.src} alt="" class="drop-shadow-xl drop-shadow-gold" />
        <p class="font-display text-[1.4rem] tracking-[0.08em] text-crimson">
            {displayDate}
        </p>
        <p class="font-display text-[1.4rem] tracking-[0.08em] text-crimson">
            Horario: si - si
        </p>
    </div>
    <img
        class="absolute left-1/2 bottom-0 z-2 w-[clamp(52px,9vw,78px)] -translate-x-1/2 translate-y-[45%]"
        src={waxSeal.src}
        alt=""
        aria-hidden="true"
        width="91"
        height="91"
    />
</article>

<script define:vars={{ EnvelopeGif }}>
    const invitationCard = document.getElementById("invitation-card");
    const backdrop = document.querySelector(".backdrop");

    function loadInvitationGif() {
        if (!invitationCard) return;

        const cacheBuster = `?t=${Date.now()}`;
        invitationCard.src = `${EnvelopeGif.src}${cacheBuster}`;
        invitationCard.style.opacity = "1";
    }

    function scheduleGifLoad() {
        window.setTimeout(loadInvitationGif, 1200);
    }

    if (
        invitationCard &&
        backdrop &&
        backdrop.classList.contains("is-shrinking")
    ) {
        backdrop.addEventListener("animationend", scheduleGifLoad, {
            once: true,
        });
    } else {
        scheduleGifLoad();
    }
</script>
