---
import Envelope1 from "../assets/EnvelopeOpening1.svg";
import Envelope2 from "../assets/EnvelopeOpening2.svg";
import Envelope3 from "../assets/EnvelopeOpening3.svg";
import Envelope4 from "../assets/EnvelopeOpening4.svg";
import EnvelopeGif from "../assets/test2.gif"
import waxSeal from "../assets/waxSeal.svg";

interface Props {
    displayDate: string;
}

const { displayDate } = Astro.props;
---

<article class="card-invitation">
    <div class="card-invitation__inner">
        <p class="eyebrow">Promoción 2026</p>

        <div class="envelope" aria-hidden="true">
            <!-- <img class="envelope__frame" src={Envelope1.src} alt="" />
            <img class="envelope__frame" src={Envelope2.src} alt="" />
            <img class="envelope__frame" src={Envelope3.src} alt="" />-->
            <!-- <img class="" src={Envelope4.src} alt="" /> -->
            <img  src={EnvelopeGif.src} alt="" />

        </div>

        <!-- <h1 class="name">Judith</h1> -->

        <p class="salutation">Estimado/a <span data-guest-name>invitado/a</span>,</p>
        <p class="body">Te invitamos cordialmente a celebrar su graduación</p>
        <p class="date">{displayDate}</p>
    </div>

    <img class="seal" src={waxSeal.src} alt="" aria-hidden="true" width="91" height="91" />
</article>

<style>
    .card-invitation {
        position: relative;
        max-width: 680px;
        margin-inline: auto;
        padding: clamp(1.5rem, 5vw, 3.25rem);
        background: var(--color-parchment);
        color: #0e0e0e;
        text-align: center;
        border: 2px solid var(--color-gold);
    }

    .card-invitation::before {
        content: "";
        position: absolute;
        inset: 10px;
        border: 1px solid var(--color-gold);
        pointer-events: none;
    }

    .card-invitation__inner {
        position: relative;
        display: grid;
        justify-items: center;
        gap: 1.25rem;
    }

    .eyebrow {
        margin: 0;
        color: var(--color-crimson);
        font-size: 0.9rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
    }

    .name {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 8vw, 4rem);
        font-weight: 700;
    }

    .salutation {
        margin: 0;
        font-size: 1.35rem;
        font-style: italic;
    }

    .body {
        margin: 0;
        max-width: 34ch;
        font-size: 1.15rem;
        line-height: 1.6;
    }

    .date {
        margin: 0;
        color: var(--color-crimson);
        font-family: var(--font-display);
        font-size: 1.4rem;
        letter-spacing: 0.08em;
    }

    .seal {
        position: absolute;
        left: 50%;
        bottom: 0;
        width: clamp(52px, 9vw, 78px);
        transform: translate(-50%, 45%);
        z-index: 1;
    }

    .envelope {
        position: relative;
        width: min(78%, 300px);
        aspect-ratio: 357 / 441.75;
        margin-inline: auto;
    }

    .envelope__frame {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center bottom;
        opacity: 0;
    }

    .envelope__frame:nth-child(1) {
        animation: reveal-1 3.2s linear forwards;
    }
    .envelope__frame:nth-child(2) {
        animation: reveal-2 3.2s linear forwards;
    }
    .envelope__frame:nth-child(3) {
        animation: reveal-3 3.2s linear forwards;
    }
    .envelope__frame:nth-child(4) {
        animation: reveal-4 3.2s linear forwards;
    }

    @keyframes reveal-1 {
        0%,
        20% {
            opacity: 1;
        }
        25%,
        100% {
            opacity: 0;
        }
    }
    @keyframes reveal-2 {
        0%,
        20% {
            opacity: 0;
        }
        25%,
        45% {
            opacity: 1;
        }
        50%,
        100% {
            opacity: 0;
        }
    }
    @keyframes reveal-3 {
        0%,
        45% {
            opacity: 0;
        }
        50%,
        70% {
            opacity: 1;
        }
        75%,
        100% {
            opacity: 0;
        }
    }
    @keyframes reveal-4 {
        0%,
        70% {
            opacity: 0;
        }
        75%,
        100% {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .envelope__frame {
            animation: none;
        }
        .envelope__frame:nth-child(-n + 3) {
            opacity: 0;
        }
        .envelope__frame:nth-child(4) {
            opacity: 1;
        }
    }
</style>
