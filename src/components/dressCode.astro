---
import dressCode from "../assets/dresscode.jpeg";

const allowedColors = [
    { name: "Deep Black", hex: "#2b2b2b" }, //[cite: 1]
    { name: "Ebony", hex: "#2e3030" }, //[cite: 1]
    { name: "Snow White", hex: "#f4f5f0" }, //[cite: 1]
    { name: "Marfil", hex: "#e2d8c3" }, //[cite: 1]
    { name: "Soft Beige", hex: "#e3d3c2" }, //[cite: 1]
    { name: "Classic Beige", hex: "#d4c1ab" }, //[cite: 1]
    { name: "Light Grey", hex: "#cdd0cb" }, //[cite: 1]
    { name: "Rich Camel", hex: "#a8815c" }, //[cite: 1]
    { name: "Mid-Grey", hex: "#858784" }, //[cite: 1]
    { name: "Midnight Blue", hex: "#1e2b3c" }, //[cite: 1]
    { name: "Soft Blush", hex: "#d5a8a1" }, //[cite: 1]
    { name: "Rubor", hex: "#b57771" }, //[cite: 1]
];
---

<section
    class="card mx-auto mt-12 max-w-170 p-[clamp(1.5rem,4vw,2.5rem)]"
    aria-labelledby="dresscode-heading"
>
    <h2 id="dresscode-heading" class="text-center font-display text-gold">
        Código de vestimenta
    </h2>
    <p class="mx-auto mt-3 max-w-[52ch] text-center text-[1.15rem] leading-[1.6] text-black">
        La celebración será de etiqueta formal. Te pedimos vestir dentro de la
        siguiente paleta de colores para mantener la armonía del evento.
    </p>

    <img
        class="mx-auto mt-8 w-full max-w-130 rounded object-cover"
        src={dressCode.src}
        alt="Inspiración del código de vestimenta: trajes formales en tonos oscuros y dorados"
        loading="lazy"
    />

    <div class="mt-8 grid grid-cols-3 gap-4 sm:grid-cols-4">
        {allowedColors.map((color) => (
            <figure class="grid justify-items-center gap-2">
                <div
                    class={`h-16 w-full rounded-2xl border border-[#4a4a4a]/60 shadow-inner ${
                        color.hex === "#ffffff" ? "border-[#4a4a4a]" : ""
                    }`}
                    style={`background-color: ${color.hex}`}
                    role="img"
                    aria-label={`Color ${color.name}`}
                ></div>
                <figcaption class="text-center text-[0.85rem] uppercase leading-tight tracking-[0.06em] text-crimson">
                    {color.name}
                </figcaption>
            </figure>
        ))}
    </div>
</section>
