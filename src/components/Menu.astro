---
import menu from "../data/menu.json";
---

<section
    class="card mx-auto mt-12 max-w-170 p-[clamp(1.5rem,4vw,2.5rem)]"
    aria-labelledby="menu-heading"
>
    <h2 id="menu-heading" class="text-center font-display text-gold">
        El menú
    </h2>
    <p class="mx-auto mt-3 max-w-[52ch] text-center text-[1.15rem] leading-[1.6] text-black">
        Estas opciones de Aliño Restaurante estarán disponibles durante la
        celebración. Para cubrir la comida, se solicitará una contribución de
        aproximadamente 9$ por invitado.
    </p>

    <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {menu.items.map((item, index) => (
            <li
                class="menu-item group relative flex flex-col overflow-hidden rounded-md border border-gold/50 bg-white shadow-sm"
                style={`--reveal-delay: ${index * 80}ms`}
            >
                <div
                    class="menu-card flex flex-1 cursor-pointer flex-col"
                    role="button"
                    tabindex="0"
                    aria-haspopup="dialog"
                    aria-label={`Ver detalles de ${item.name}`}
                    data-name={item.name}
                    data-description={item.description}
                    data-image={item.image}
                >
                    <!-- <span class="absolute left-3 top-3 z-10 rounded-sm bg-crimson px-2 py-0.5 font-display text-xs tracking-[0.08em] text-cream">
                        ★ PROMO
                    </span> -->

                    <img
                        src={item.image}
                        alt={item.name}
                        loading="lazy"
                        decoding="async"
                        class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                    <div class="flex flex-1 flex-col gap-2 p-4 text-left">
                        <h3 class="font-display text-base leading-snug text-velvet">
                            {item.name}
                        </h3>
                        {item.description && (
                            <p class="menu-description line-clamp-2 text-sm leading-snug text-black/70">
                                {item.description}
                            </p>
                        )}
                    </div>
                </div>
            </li>
        ))}
    </ul>

    <dialog
        class="menu-dialog m-auto w-[calc(100%-2rem)] max-w-2xl rounded-lg border-2 border-gold bg-parchment shadow-2xl backdrop:bg-black/60 sm:w-[75%] md:w-[50%]"
        aria-labelledby="menu-dialog-title"
        aria-describedby="menu-dialog-description"
    >
        <div class="relative flex flex-col">
            <button
                type="button"
                class="menu-dialog-close cursor-pointer hover:bg-gray-400 absolute top-3 right-3 z-10 grid h-10 w-10 place-items-center rounded-full bg-white/90 text-velvet shadow transition-colors hover:text-crimson"
                aria-label="Cerrar"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>

            <img
                id="menu-dialog-image"
                src=""
                alt=""
                class="aspect-square w-full object-cover"
            />

            <div class="flex flex-col gap-3 p-6 text-left">
                <h3
                    id="menu-dialog-title"
                    class="font-display text-xl leading-snug text-velvet"
                ></h3>
                <p
                    id="menu-dialog-description"
                    class="text-base leading-relaxed text-black/80"
                ></p>
            </div>
        </div>
    </dialog>
</section>

<style>
    .menu-item {
        opacity: 0;
        transform: translateY(24px);
        transition:
            opacity 0.6s ease var(--reveal-delay, 0ms),
            transform 0.6s ease var(--reveal-delay, 0ms),
            scale 0.3s ease,
            box-shadow 0.3s ease,
            border-color 0.3s ease;
    }

    .menu-item.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .menu-item:hover {
        scale: 1.03;
        box-shadow:
            0 10px 25px -5px rgba(0, 0, 0, 0.1),
            0 8px 10px -6px rgba(0, 0, 0, 0.1);
        border-color: rgba(166, 31, 31, 0.6);
    }

    .menu-description {
        opacity: 0.85;
        transition: opacity 0.3s ease;
    }

    .menu-card:hover .menu-description {
        opacity: 1;
    }

    .menu-dialog::backdrop {
        background: rgba(0, 0, 0, 0.6);
        opacity: 0;
        transition: opacity 0.3s ease allow-discrete;
    }

    .menu-dialog[open]::backdrop {
        opacity: 1;
    }

    .menu-dialog {
        position: fixed;
        inset: 0;
        opacity: 0;
        transform: scale(0.96) translateY(16px);
        transition:
            opacity 0.3s ease,
            transform 0.3s ease,
            overlay 0.3s ease allow-discrete,
            display 0.3s ease allow-discrete;
    }

    .menu-dialog[open] {
        opacity: 1;
        transform: scale(1) translateY(0);
    }

    @starting-style {
        .menu-dialog[open] {
            opacity: 0;
            transform: scale(0.96) translateY(16px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .menu-item {
            opacity: 1;
            transform: none;
            transition: none;
        }

        .menu-description {
            opacity: 1;
            transition: none;
        }

        .menu-dialog,
        .menu-dialog::backdrop {
            transition: none;
        }
    }
</style>

<script>
    const items = document.querySelectorAll(".menu-item");
    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reducedMotion || !("IntersectionObserver" in window)) {
        items.forEach((item) => item.classList.add("is-visible"));
    } else {
        const observer = new IntersectionObserver(
            (entries, observer) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.15 },
        );

        items.forEach((item) => observer.observe(item));
    }

    const dialog = document.querySelector<HTMLDialogElement>(".menu-dialog");
    const dialogImage =
        document.querySelector<HTMLImageElement>("#menu-dialog-image");
    const dialogTitle =
        document.querySelector<HTMLElement>("#menu-dialog-title");
    const dialogDescription = document.querySelector<HTMLElement>(
        "#menu-dialog-description",
    );
    const dialogClose =
        document.querySelector<HTMLButtonElement>(".menu-dialog-close");

    if (dialog && dialogImage && dialogTitle && dialogDescription) {
        function openDialog(card: HTMLElement) {
            const name = card.dataset.name ?? "";
            const description = card.dataset.description ?? "";
            const image = card.dataset.image ?? "";

            dialogImage.src = image;
            dialogImage.alt = name;
            dialogTitle.textContent = name;
            dialogDescription.innerHTML = description;

            dialog.showModal();
        }

        document.querySelectorAll<HTMLElement>(".menu-card").forEach((card) => {
            card.addEventListener("click", () => openDialog(card));
            card.addEventListener("keydown", (event) => {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    openDialog(card);
                }
            });
        });

        dialogClose?.addEventListener("click", () => dialog.close());

        dialog.addEventListener("click", (event) => {
            const rect = dialog.getBoundingClientRect();
            const isInDialog =
                event.clientX >= rect.left &&
                event.clientX <= rect.right &&
                event.clientY >= rect.top &&
                event.clientY <= rect.bottom;
            if (!isInDialog) {
                dialog.close();
            }
        });
    }
</script>
