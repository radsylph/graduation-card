---
interface Props {
    typeOrigin: string;
}

const { typeOrigin } = Astro.props;
const apiUrl = import.meta.env.APP_SCRIPT_URL;
---

<section
    class="card mx-auto mt-12 max-w-170 p-[clamp(1.5rem,4vw,2.5rem)]"
    aria-labelledby="rsvp-heading"
>
    <h2 id="rsvp-heading" class="mb-1 font-display text-gold">
        Confirmar asistencia
    </h2>
    <p class="mb-6 text-cream">Por favor, confirma tu asistencia.</p>

    <form
        class="grid gap-5 justify-center"
        data-rsvp-form
        data-api-url={apiUrl}
        data-event={typeOrigin}
        novalidate
    >
        <input type="hidden" name="typeOrigin" value={typeOrigin} />

        <label class="grid gap-[0.4rem]">
            <span class="text-[0.85rem] uppercase tracking-[0.08em] text-crimson">
                Nombre
            </span>
            <input
                class="w-full rounded-sm border border-[#4a4a4a] p-[0.7rem_0.9rem] text-black focus-visible:border-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-gold"
                type="text"
                name="name"

                autocomplete="name"
                data-input-name
                data-guest-input
                id="nameInput"
            />
            <p
                class="text-sm text-crimson"
                data-error-name
                role="alert"
                hidden
            ></p>
        </label>

        <label class="grid gap-[0.4rem]">
            <span class="text-[0.85rem] uppercase tracking-[0.08em] text-crimson">
                Correo electrónico
            </span>
            <input
                class="w-full rounded-sm border border-[#4a4a4a] p-[0.7rem_0.9rem] text-black focus-visible:border-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-gold"
                type="email"
                name="email"

                autocomplete="email"
                data-input-email
                id="emailInput"
            />
            <p
                class="text-sm text-crimson"
                data-error-email
                role="alert"
                hidden
            ></p>
        </label>

        <fieldset class="grid gap-[0.4rem]">
            <legend class="text-[0.85rem] uppercase tracking-[0.08em] text-crimson">
                ¿Asistirás?
            </legend>
            <label class="flex cursor-pointer items-center gap-[0.6rem] text-black">
                <input
                    class="accent-velvet"
                    type="radio"
                    name="attending"
                    value="true"
                    required
                />
                <span>Asistiré con gusto</span>
            </label>
            <label class="flex cursor-pointer items-center gap-[0.6rem] text-black">
                <input
                    class="accent-velvet"
                    type="radio"
                    name="attending"
                    value="false"
                    required
                />
                <span>Lamentablemente no podré asistir</span>
            </label>
            <p
                class="text-sm text-crimson"
                data-error-attending
                role="alert"
                hidden
            ></p>
        </fieldset>

        <button
            class="inline-flex cursor-pointer items-center justify-center gap-2 justify-self-start rounded-sm border-0 bg-velvet p-[0.8rem_1.6rem] font-display tracking-[0.06em] text-cream transition-colors duration-200 hover:bg-crimson focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold disabled:cursor-not-allowed disabled:hover:bg-velvet disabled:opacity-70"
            type="submit"
            aria-busy="false"
        >
            <span class="spinner" data-spinner aria-hidden="true" hidden></span>
            <span data-button-text>Enviar confirmación</span>
        </button>

        <p class="text-emerald-600" data-confirmation hidden role="status"></p>
    </form>

    <div
        class="grid gap-4"
        data-rsvp-confirmation
        role="status"
        tabindex="-1"
        hidden
    >
        <p class="text-emerald-600" data-rsvp-confirmation-text></p>
        <button
            class="inline-flex cursor-pointer items-center justify-center gap-2 justify-self-start rounded-sm border-0 bg-velvet p-[0.8rem_1.6rem] font-display tracking-[0.06em] text-cream transition-colors duration-200 hover:bg-crimson focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
            type="button"
            data-rsvp-clear
        >
            ¿Cambiar mi respuesta?
        </button>
    </div>
</section>

<style>
    .spinner {
        width: 1rem;
        height: 1rem;
        border-radius: 9999px;
        border: 2px solid currentColor;
        border-top-color: transparent;
        animation: spin 0.7s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .spinner {
            animation-duration: 1.5s;
        }
    }
</style>

<script>
    // @ts-nocheck
    import { clearRsvp, getRsvp, saveRsvp } from "../lib/rsvp-store";

    const form = document.querySelector("[data-rsvp-form]");
    const apiUrl = form?.dataset.apiUrl ?? "";
    const typeOrigin = form?.dataset.event ?? "";
    const emailRegex =
        /^(?!\.)(?!.*\.\.)([a-z0-9_'+'\.\.]*)[a-z0-9_+\-]@([a-z0-9][a-z0-9\-]*\.)+[a-z]{2,}$/i;

    if (form) {
        const confirmation = form.querySelector("[data-confirmation]");
        const rsvpConfirmation = document.querySelector(
            "[data-rsvp-confirmation]",
        );
        const rsvpConfirmationText = rsvpConfirmation?.querySelector(
            "[data-rsvp-confirmation-text]",
        );
        const clearButton =
            rsvpConfirmation?.querySelector("[data-rsvp-clear]");
        const nameInput = form.querySelector("[data-input-name]");
        const emailInput = form.querySelector("[data-input-email]");
        const attendingInputs = form.querySelectorAll(
            "input[name='attending']",
        );
        const nameError = form.querySelector("[data-error-name]");
        const emailError = form.querySelector("[data-error-email]");
        const attendingError = form.querySelector("[data-error-attending]");

        const submitButton = form.querySelector("button[type='submit']");
        const spinner = submitButton?.querySelector("[data-spinner]");
        const buttonText = submitButton?.querySelector("[data-button-text]");
        const restingText = buttonText?.textContent ?? "Enviar confirmación";

        function setLoading(loading) {
            if (!submitButton) return;
            if (loading) {
                submitButton.setAttribute("disabled", "");
            } else {
                submitButton.removeAttribute("disabled");
            }
            submitButton.setAttribute("aria-busy", String(loading));
            if (spinner) spinner.hidden = !loading;
            if (buttonText) {
                buttonText.textContent = loading ? "Enviando…" : restingText;
            }
        }

        function cleanForm() {
            form.reset();
            // setTimeout(() => {
            //     form.setAttribute("hidden", "");
            // }, 1000);
        }

        function clearErrors() {
            nameInput?.classList.remove("!border-crimson");
            emailInput?.classList.remove("!border-crimson");
            nameError?.setAttribute("hidden", "");
            emailError?.setAttribute("hidden", "");
            attendingError?.setAttribute("hidden", "");
        }

        function showTextError(input, errorEl, message) {
            input?.classList.add("!border-crimson");
            if (errorEl) {
                errorEl.textContent = message;
                errorEl.removeAttribute("hidden");
            }
        }

        function showAttendingError(message) {
            if (attendingError) {
                attendingError.textContent = message;
                attendingError.removeAttribute("hidden");
            }
        }

        function renderState() {
            const record = getRsvp(typeOrigin);

            if (record && rsvpConfirmation && rsvpConfirmationText) {
                form.setAttribute("hidden", "");
                rsvpConfirmationText.textContent = record.attending
                    ? `¡Gracias, ${record.name}! Tu asistencia está confirmada.`
                    : `Lamentamos que no puedas acompañarnos, ${record.name}. Tu respuesta ha quedado registrada.`;
                rsvpConfirmation.removeAttribute("hidden");
            } else if (rsvpConfirmation) {
                rsvpConfirmation.setAttribute("hidden", "");
                form.removeAttribute("hidden");
                clearErrors();
                confirmation?.setAttribute("hidden", "");
            }
        }

        clearButton?.addEventListener("click", () => {
            const record = getRsvp(typeOrigin);
            clearRsvp(typeOrigin);
            renderState();

            if (record) {
                if (nameInput) nameInput.value = record.name;
                if (emailInput) emailInput.value = record.email;
                attendingInputs.forEach((radio) => {
                    radio.checked = String(record.attending) === radio.value;
                });
            }

            nameInput?.focus();
        });

        renderState();
        nameInput?.addEventListener("input", () => {
            nameInput.classList.remove("!border-crimson");
            nameError?.setAttribute("hidden", "");
        });

        emailInput?.addEventListener("input", () => {
            emailInput.classList.remove("!border-crimson");
            emailError?.setAttribute("hidden", "");
        });

        attendingInputs.forEach((radio) => {
            radio.addEventListener("change", () => {
                attendingError?.setAttribute("hidden", "");
            });
        });

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            clearErrors();

            const formData = new FormData(form);
            const name = String(formData.get("name") ?? "").trim();
            const email = String(formData.get("email") ?? "").trim();
            const attending = formData.get("attending");

            let isValid = true;

            if (!name) {
                showTextError(
                    nameInput,
                    nameError,
                    "Por favor, ingresa tu nombre.",
                );
                isValid = false;
            }
            if (!email) {
                showTextError(
                    emailInput,
                    emailError,
                    "Por favor, ingresa tu correo electrónico.",
                );
                isValid = false;
            } else if (!emailRegex.test(email)) {
                showTextError(
                    emailInput,
                    emailError,
                    "Por favor, ingresa un correo electrónico válido.",
                );
                isValid = false;
            }

            if (!attending) {
                showAttendingError("Por favor, indica si asistirás.");
                isValid = false;
            }

            if (!isValid) return;

            setLoading(true);

            const payload = new FormData();
            payload.append("name", name);
            payload.append("email", email);
            payload.append("check", String(attending));
            payload.append("typeOrigin", String(typeOrigin));

            try {
                const response = await fetch(apiUrl, {
                    method: "POST",
                    body: payload,
                });

                if (response.ok) {
                    if (confirmation) {
                        confirmation.textContent = name
                            ? `¡Gracias, ${name}! Tu respuesta ha quedado registrada.`
                            : "¡Gracias! Tu respuesta ha quedado registrada.";
                        confirmation.removeAttribute("hidden");
                    }
                    saveRsvp(typeOrigin, {
                        name,
                        email,
                        attending: attending === "true",
                        submittedAt: new Date().toISOString(),
                    });
                    cleanForm();
                    renderState();
                    rsvpConfirmation?.focus();
                } else {
                    if (confirmation) {
                        confirmation.textContent =
                            "Hubo un problema al enviar tu respuesta. Por favor, inténtalo de nuevo.";
                        confirmation.removeAttribute("hidden");
                    }
                }
            } catch {
                if (confirmation) {
                    confirmation.textContent =
                        "No se pudo conectar con el servidor. Por favor, inténtalo más tarde.";
                    confirmation.removeAttribute("hidden");
                }
            } finally {
                setLoading(false);
            }
        });
    }
</script>
