---
---

<section
    class="card mx-auto mt-12 max-w-170 p-[clamp(1.5rem,4vw,2.5rem)]"
    aria-labelledby="rsvp-heading"
>
    <h2 id="rsvp-heading" class="mb-1 font-display text-gold">
        Confirmar asistencia
    </h2>
    <p class="mb-6 text-cream">Por favor, confirma tu asistencia.</p>

    <form class="grid gap-5 justify-center" data-rsvp-form>
        <label class="grid gap-[0.4rem]">
            <span class="text-[0.85rem] uppercase tracking-[0.08em] text-crimson">
                Nombre
            </span>
            <input
                class="w-full rounded-sm border border-[#4a4a4a] p-[0.7rem_0.9rem] text-black focus-visible:border-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-gold"
                type="text"
                name="name"
                required
                autocomplete="name"
                data-guest-input
            />
        </label>

        <label class="grid gap-[0.4rem]">
            <span class="text-[0.85rem] uppercase tracking-[0.08em] text-crimson">
                Correo electrónico
            </span>
            <input
                class="w-full rounded-sm border border-[#4a4a4a] p-[0.7rem_0.9rem] text-black focus-visible:border-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-gold"
                type="email"
                name="email"
                required
                autocomplete="email"
            />
        </label>

        <fieldset class="grid gap-[0.4rem]">
            <legend class="text-[0.85rem] uppercase tracking-[0.08em] text-crimson">
                ¿Asistirás?
            </legend>
            <label class="flex cursor-pointer items-center gap-[0.6rem] text-black">
                <input
                    class="accent-velvet"
                    type="radio"
                    name="attending"
                    value="yes"
                    required
                />
                <span>Asistiré con gusto</span>
            </label>
            <label class="flex cursor-pointer items-center gap-[0.6rem] text-black">
                <input
                    class="accent-velvet"
                    type="radio"
                    name="attending"
                    value="no"
                    required
                />
                <span>Lamentablemente no podré asistir</span>
            </label>
        </fieldset>

        <button
            class="justify-self-start rounded-sm border-0 bg-velvet p-[0.8rem_1.6rem] font-display tracking-[0.06em] text-cream transition-colors duration-200 hover:bg-crimson focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
            type="submit"
        >
            Enviar confirmación
        </button>

        <p class="text-gold" data-confirmation hidden role="status"></p>
    </form>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>("[data-rsvp-form]");
    if (form) {
        const confirmation = form.querySelector<HTMLElement>(
            "[data-confirmation]",
        );

        form.addEventListener("submit", (event) => {
            event.preventDefault();

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const name = String(new FormData(form).get("name") ?? "").trim();

            if (confirmation) {
                confirmation.textContent = name
                    ? `¡Gracias, ${name}! Tu respuesta ha quedado registrada.`
                    : "¡Gracias! Tu respuesta ha quedado registrada.";
                confirmation.removeAttribute("hidden");
            }

            form.reset();
        });
    }
</script>
