---
import Layout from "../layouts/Layout.astro";
import envelope from "../assets/closedEnveloped.svg";
import flatEnvelope from "../assets/FlatEnvlopedOpen.svg";
import waxSeal from "../assets/waxSeal.svg";
---

<Layout title="Judith — Invitación">
    <main class="welcome">
        <h1 class="visually-hidden">Tienes una invitación</h1>
        <div class="envelope">
            <img
                class="envelope__img envelope__img--closed"
                src={envelope.src}
                alt="Sobre cerrado"
                width="482"
                height="303"
                fetchpriority="high"
            />
            <img
                class="envelope__img envelope__img--flat"
                src={flatEnvelope.src}
                alt="Sobre abierto"
                width="482"
                height="303"
            />
            <a class="seal" href="/invitation" aria-label="Abrir la invitación">
                <img src={waxSeal.src} alt="" width="91" height="91" />
            </a>
        </div>
        <div class="backdrop" aria-hidden="true"></div>
    </main>
</Layout>

<style>
    .welcome {
        --paper: #f5f1e8;
        min-height: 100vh;
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: clamp(1rem, 4vw, 3rem);
        background: var(--paper);
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .envelope {
        position: relative;
        width: min(20vw, calc(88svh * 1.5906));
        aspect-ratio: 361.5 / 227.25;
        animation: envelope-initial 1.1s ease-out both;
        /* Zoom level at which the flat envelope (a near-square, near-solid
           wine image) covers a desktop viewport when scaled from its center. */
        /*--flat-cover: 5.5;*/
    }

    @media screen and (max-width: 768px) {
        .envelope {
            width: min(92vw, calc(88svh * 1.5906));
            --flat-cover: 3;
        }
    }

    .envelope__img {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        user-select: none;
    }

    /* Full envelope width, vertically centered; capped so it fits short viewports. */
    .envelope__img--flat {
        opacity: 0;
        top: 18%;
        left: 50%;
        bottom: auto;
        right: auto;
        width: min(100%, 87svh);
        height: auto;
        translate: -50% -50%;
    }


    @keyframes envelope-initial {
        from {
            opacity: 0;
            transform: translateY(45svh);
        }

        40% {
            opacity: 1;
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes envelope-closed-out {
        to {
            opacity: 0;
            transform: scale(0.96);
        }
    }

    /* The open envelope zooms from its center until it fills the viewport. */
    @keyframes envelope-flat-in {
        0% {
            opacity: 0;
            transform: scale(1);
        }

        50% {
            opacity: 1;
        }

        75%,
        100% {
            transform: scale(var(--flat-cover, 5.5));
        }
    }

    .envelope.opening .envelope__img--closed {
        animation: envelope-closed-out 0.4s ease 0.4s forwards;
    }

    .envelope.opening .envelope__img--flat {
        animation: envelope-flat-in 0.8s ease 0.4s forwards;
    }

    /* Wine backdrop: as the envelope zoom is finishing, the whole viewport
       fades to exactly --color-wine, so arriving at the invitation page
       (whose hero uses the same color) feels like one continuous scene.
       Hidden with opacity (not display) so it can actually animate. */
    .backdrop {
        position: fixed;
        inset: 0;
        z-index: 2;
        background: var(--color-wine);
        opacity: 0;
        pointer-events: none;
    }

    .backdrop.is-open {
        animation: backdrop-in 0.5s ease 0.75s forwards;
    }

    @keyframes backdrop-in {
        to {
            opacity: 1;
        }
    }

    .seal {
        position: absolute;
        left: 50%;
        top: 70%;
        width: 20%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        transition:
            transform 0.4s ease,
            opacity 0.4s ease;
    }

    .seal img {
        display: block;
        width: 100%;
        height: 100%;
        user-select: none;
    }

    .seal:hover {
        transform: translate(-50%, -50%) scale(1.06);
        filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.28));
    }

    .seal:focus-visible {
        outline: 3px solid #8a3b2f;
        outline-offset: 4px;
    }

    .seal.peeling {
        transform: translate(-50%, -50%) scale(1.25) rotate(10deg);
        opacity: 0;
        filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.35));
    }

    @media (prefers-reduced-motion: reduce) {
        .seal,
        .backdrop,
        .envelope,
        .envelope__img {
            transition: none;
            animation: none;
        }
    }
</style>

<script>
    const seal = document.querySelector<HTMLAnchorElement>(".seal");
    const envelope = document.querySelector<HTMLDivElement>(".envelope");
    const backdrop = document.querySelector<HTMLDivElement>(".backdrop");

    if (seal && envelope && backdrop) {
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        let opening = false;
        let navigationTimer: number | undefined;

        // Returning to this page via the browser back button restores it from the
        // back/forward cache in its "opened" state — reset to the sealed envelope.
        window.addEventListener("pageshow", (event) => {
            if (!event.persisted) return;

            window.clearTimeout(navigationTimer);
            opening = false;
            seal.classList.remove("peeling");
            envelope.classList.remove("opening");
            backdrop.classList.remove("is-open");
        });

        seal.addEventListener("click", (event: MouseEvent) => {
            // Let native navigation handle reduced-motion, non-primary, and new-tab clicks.
            if (
                opening ||
                reducedMotion ||
                event.button !== 0 ||
                event.metaKey ||
                event.ctrlKey ||
                event.shiftKey ||
                event.altKey
            ) {
                return;
            }

            event.preventDefault();
            opening = true;
            seal.classList.add("peeling");
            envelope.classList.add("opening");
            backdrop.classList.add("is-open");

            const href = seal.getAttribute("href") ?? "/invitation";
            // 400ms peel + 800ms zoom (delayed 400ms) + 500ms wine backdrop
            // (delayed 750ms) + a beat on the wine screen before navigating.
            navigationTimer = window.setTimeout(
                () => window.location.assign(href),
                1500,
            );
        });
    }
</script>
