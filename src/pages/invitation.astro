---
import Layout from "../layouts/Layout.astro";
import InvitationCard from "../components/InvitationCard.astro";
import Countdown from "../components/Countdown.astro";
import RsvpForm from "../components/RsvpForm.astro";

// TODO: confirm the ceremony time once the venue details are finalized.
const EVENT_DATE = "2026-10-10T18:00:00-04:00";

const event = new Date(EVENT_DATE);
const displayDate = new Intl.DateTimeFormat("es", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
}).format(event);
---

<Layout title="Judith — Invitación de graduación">
    <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        slot="head"
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />
    <link
        slot="head"
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap"
    />

    <main class="invitation">
        <section class="hero">
            <InvitationCard displayDate={displayDate} />
            <Countdown date={EVENT_DATE} />
        </section>

        <section class="location card" aria-labelledby="location-heading">
            <h2 id="location-heading">Ubicación</h2>
            <div class="location__grid">
                <!-- TODO: replace with the real venue address. -->
                <iframe
                    class="location__map"
                    title="Mapa de la ubicación del evento"
                    src="https://www.google.com/maps?q=New%20York%2C%20NY&output=embed"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                ></iframe>
                <div class="location__text">
                    <h3>Nombre del lugar</h3>
                    <p>Avenida Ejemplo 123</p>
                    <p>New York, NY 10001</p>
                    <p class="location__note">Detalles por confirmar.</p>
                </div>
            </div>
        </section>

        <RsvpForm />
    </main>
</Layout>

<style>
    .invitation {
        --padding-block: clamp(1.5rem, 5vw, 4rem);
        --padding-inline: clamp(1rem, 4vw, 3rem);
        min-height: 100vh;
        background: var(--color-canvas);
        color: var(--color-cream);
        font-family: var(--font-serif);
        padding: var(--padding-block) var(--padding-inline);
    }

    /* Full-bleed wine band: the negative margins cancel the page padding so
       this section runs edge-to-edge and touches the top of the page — the
       same color the visitor was looking at when the envelope zoom finished
       on the welcome page. */
    .hero {
        display: grid;
        gap: 2rem;
        justify-items: center;
        margin-block-start: calc(-1 * var(--padding-block));
        margin-inline: calc(-1 * var(--padding-inline));
        padding: clamp(2.5rem, 6vw, 4rem) var(--padding-inline);
        background: var(--color-wine);
    }

    .location {
        max-width: 960px;
        margin: 3rem auto 0;
        padding: clamp(1.5rem, 4vw, 2.5rem);
    }

    .location h2 {
        margin: 0 0 1.25rem;
        color: var(--color-gold);
        font-family: var(--font-display);
    }

    .location__grid {
        display: grid;
        gap: 1.5rem;
    }

    @media (min-width: 720px) {
        .location__grid {
            grid-template-columns: 1fr 1fr;
            align-items: stretch;
        }
    }

    .location__map {
        width: 100%;
        min-height: 280px;
        border: 0;
        filter: grayscale(1) contrast(1.05);
    }

    .location__text h3 {
        margin: 0 0 0.5rem;
        color: var(--color-crimson);
        font-family: var(--font-display);
    }

    .location__text p {
        margin: 0.15rem 0;
        color: var(--color-cream);
    }

    .location__note {
        margin-top: 1rem;
        font-style: italic;
        color: var(--color-gold);
    }
</style>

<script>
    // Personalize the invitation from a `?guest=Jane` query parameter. The
    // value is rendered as plain text and pre-fills the RSVP name field.
    const params = new URLSearchParams(window.location.search);
    const guest = (params.get("guest") ?? "").trim().slice(0, 80);

    if (guest) {
        document
            .querySelectorAll<HTMLElement>("[data-guest-name]")
            .forEach((el) => {
                el.textContent = guest;
            });
        document
            .querySelectorAll<HTMLInputElement>("[data-guest-input]")
            .forEach((el) => {
                el.value = guest;
            });
    }
</script>
