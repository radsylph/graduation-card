---
import Layout from "../layouts/Layout.astro";
import InvitationCard from "../components/InvitationCard.astro";
import Countdown from "../components/Countdown.astro";
import RsvpForm from "../components/RsvpForm.astro";
import DressCode from "../components/dressCode.astro";
import Location from "../components/Location.astro";
import FadeInText from "@astroanimate/core/FadeInText";

const EVENT_DATE = "2026-10-10T18:00:00-04:00";

const event = new Date(EVENT_DATE);
const displayDate = new Intl.DateTimeFormat("es", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
}).format(event);
---

<div
    class="backdrop pointer-events-none z-99 bg-wine opacity-0"
    aria-hidden="true"
></div>
<Layout title="Judith — Invitación de graduación">
    <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        slot="head"
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />
    <link
        slot="head"
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap"
    />

    <main class="min-h-screen bg-parchment p-[clamp(1.5rem,5vw,4rem)_clamp(1rem,4vw,3rem)] font-serif text-cream">
        <FadeInText enhance duration={0.7} yOffset={30}>
            <section class="-mt-[clamp(1.5rem,5vw,4rem)] -mx-[clamp(1rem,4vw,3rem)] grid gap-8 justify-items-center bg-white px-[clamp(1rem,4vw,3rem)] py-[clamp(2.5rem,6vw,4rem)]">
                <InvitationCard displayDate={displayDate} />
                <Countdown date={EVENT_DATE} />
            </section>
        </FadeInText>

        <FadeInText enhance duration={0.7} yOffset={30} delay={0.1}>
            <div class="relative mx-auto max-w-240">
                <Location />
            </div>
        </FadeInText>

        <FadeInText enhance duration={0.7} yOffset={30} delay={0.2}>
            <DressCode />
        </FadeInText>

        <FadeInText enhance duration={0.7} yOffset={30} delay={0.3}>
            <RsvpForm />
        </FadeInText>
    </main>
</Layout>

<style>
    /* Vintage/sepia tint for the embedded map, matching the parchment theme.
       CSS filters apply to the iframe's rendered content from outside (we can't
       restyle the map's internal elements directly through the iframe). */
    .map-embed {
        filter: sepia(0.55) saturate(1.2) hue-rotate(330deg) contrast(1.02)
            brightness(1.02);
    }

    /* The splash is a huge circle (side = 100vmax covers any viewport) centered
       on screen, so it always stays a perfect ball while it spins and collapses.
       It's centered with negative margins (not margin:auto) because the element
       is larger than the viewport and auto-centering fails on oversized boxes. */
    .backdrop {
        position: fixed;
        top: 50%;
        left: 50%;
        width: 100vmax;
        aspect-ratio: 1;
        margin: -50vmax 0 0 -50vmax;
        pointer-events: none;
        transform-origin: 50% 50%;
    }

    .backdrop.is-shrinking {
        /* 0.4s delay keeps the full-screen splash visible before it collapses. */
        animation: backdrop-shrink-out 1.2s cubic-bezier(0.7, 0, 0.3, 1) 0.4s
            both;
    }

    @keyframes backdrop-shrink-out {
        0% {
            opacity: 1;
            /*border-radius: 50%;*/
            transform: scale(1) rotate(0deg);
        }

        45% {
            opacity: 1;
            transform: scale(0.35) rotate(240deg);
            border-radius: 25%;
        }

        80% {
            opacity: 1;
            transform: scale(0.05) rotate(360deg);
            border-radius: 50%;
        }

        100% {
            opacity: 0;
            transform: scale(0.001) rotate(420deg);
            border-radius: 80%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .backdrop {
            animation: none;
        }
    }
</style>

<script>
    const backdrop = document.querySelector<HTMLElement>(".backdrop");
    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (backdrop && !reducedMotion) {
        window.addEventListener("pageshow", (event) => {
            if (!event.persisted) return;
            backdrop.classList.remove("is-shrinking");
            void backdrop.offsetWidth;
            backdrop.classList.add("is-shrinking");
        });

        requestAnimationFrame(() => backdrop.classList.add("is-shrinking"));
    }
</script>

<script>
    const params = new URLSearchParams(window.location.search);
    const guest = (params.get("guest") ?? "").trim().slice(0, 80);

    if (guest) {
        document
            .querySelectorAll<HTMLElement>("[data-guest-name]")
            .forEach((el) => {
                el.textContent = guest;
            });
        document
            .querySelectorAll<HTMLInputElement>("[data-guest-input]")
            .forEach((el) => {
                el.value = guest;
            });
    }
</script>
