---
import Layout from "../layouts/Layout.astro";
import Menu from "../components/Menu.astro";
---

<Layout title="Judith — Menú">
    <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        slot="head"
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />
    <link
        slot="head"
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap"
    />

    <main class="min-h-screen bg-parchment text-cream">
        <Menu />
    </main>

    <button
        type="button"
        class="back-to-top fixed bottom-6 right-6 z-20 grid h-12 w-12 cursor-pointer place-items-center rounded-full border border-gold bg-velvet text-gold opacity-0 shadow-lg transition-opacity duration-300 hover:bg-crimson focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
        aria-label="Volver arriba"
    >
        <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M18 15l-6-6-6 6" />
        </svg>
    </button>

    <script>
        const backToTop =
            document.querySelector<HTMLButtonElement>(".back-to-top");

        function toggleVisibility() {
            if (!backToTop) return;
            const isVisible = window.scrollY > 600;
            backToTop.style.opacity = isVisible ? "1" : "0";
            backToTop.style.pointerEvents = isVisible ? "auto" : "none";
        }

        backToTop?.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        window.addEventListener("scroll", toggleVisibility, { passive: true });
        toggleVisibility();
    </script>
</Layout>
